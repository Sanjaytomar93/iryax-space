<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not restore auth/session storage (GetStorage). -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="GetStorage" />
        <exclude domain="file" path="get_storage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="GetStorage" />
        <exclude domain="file" path="get_storage" />
    </device-transfer>
</data-extraction-rules>

